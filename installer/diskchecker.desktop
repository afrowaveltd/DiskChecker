[Desktop Entry]
Version=1.0
Type=Application
Name=DiskChecker
Name[cs]=DiskChecker
Comment=Disk health monitoring and sanitization tool
Comment[cs]=Nástroj pro kontrolu zdraví disků a sanitizaci
Exec=/usr/bin/diskchecker
TryExec=/usr/bin/diskchecker
Path=/opt/diskchecker
Icon=diskchecker
Terminal=false
Categories=System;Filesystem;Settings;
Keywords=disk;health;smart;sanitization;ssd;hdd;
StartupNotify=true
