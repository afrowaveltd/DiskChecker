<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia"
             x:Class="DiskChecker.UI.Avalonia.Views.DiskComparisonView"
             x:Name="Root"
             Background="{DynamicResource ThemeBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="PageHeader">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel>
                    <TextBlock Text="{Binding L[DiskComparison.Title]}" Classes="PageTitle"/>
                    <TextBlock Text="{Binding L[Comparison.Description]}" Classes="PageSubtitle"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding L[DiskComparison.CompareSelected]}"
                        Command="{Binding CompareDisksCommand}" IsEnabled="{Binding CanCompare}" Padding="12,6"/>
                <Button Grid.Column="2" Content="{Binding L[DiskComparison.ExportCsv]}"
                        Command="{Binding ExportComparisonCommand}" IsEnabled="{Binding CanExport}" Padding="12,6"/>
                <Button Grid.Column="3" Content="{Binding L[DiskComparison.Back]}"
                        Command="{Binding GoBackCommand}" Padding="12,6"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16" Spacing="12">
                <Border Background="{DynamicResource ThemeCardBackgroundBrush}"
                        CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[DiskComparison.AvailableDisks]}" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding AvailableDisks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3" ColumnSpacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding ModelName}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SerialNumber}" FontSize="11"/>
                                                <TextBlock Text="{Binding CapacityText}" FontSize="11"/>
                                                <TextBlock Text="{Binding OverallGrade}" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding #Root.DataContext.L[DiskComparison.Add]}"
                                                Command="{Binding #Root.DataContext.AddDiskCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding #Root.DataContext.IsNotLoading}"
                                                Padding="10,5"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ThemeCardBackgroundBrush}"
                        CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding L[DiskComparison.SelectedDisks]}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding L[DiskComparison.SelectionHint]}" FontSize="11"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding SelectedDisks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3" ColumnSpacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Disk.ModelName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Disk.SerialNumber}" FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding #Root.DataContext.L[DiskComparison.Remove]}"
                                                Command="{Binding #Root.DataContext.RemoveDiskCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding #Root.DataContext.IsNotLoading}"
                                                Padding="10,5"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10" IsVisible="{Binding HasComparison}">
                    <TextBlock Text="{Binding BestDiskText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding ComparisonResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="8"
                                        Padding="12" Margin="0,0,0,6">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Rank, StringFormat='#{0}'}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Disk.ModelName}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Disk.CapacityText}"/>
                                            <TextBlock Text="{Binding Grade}"/>
                                            <TextBlock Text="{Binding Score, StringFormat='{}{0:F1}/100'}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding WriteSpeedText}"/>
                                            <TextBlock Text="{Binding ReadSpeedText}"/>
                                            <TextBlock Text="{Binding ErrorCount, StringFormat='Errors: {0}'}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding L[DiskComparison.ScoreChart]}" FontWeight="Bold"/>
                            <oxy:PlotView Model="{Binding ComparisonChartModel}" Height="250"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding L[DiskComparison.SpeedChart]}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding L[DiskComparison.MissingMeasurement]}" FontSize="11" TextWrapping="Wrap"/>
                            <oxy:PlotView Model="{Binding SpeedChartModel}" Height="250"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Classes="StatusBar">
            <TextBlock Text="{Binding StatusMessage}" Margin="16,5" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
